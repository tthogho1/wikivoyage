# Copy this file to .env and fill in your values.
# .env is NOT committed to version control. Every entry point loads it; real environment variables win.

# ----- Zilliz Cloud (stages 3-4, search) -----
ZILLIZ_URI=https://xxxx.zillizcloud.com
ZILLIZ_TOKEN=<your-api-key>

# ----- OpenAI (webapp answers) -----
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4o-mini

# ----- AWS (S3 input/output) -----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=

# ----- Stage 1: get_wikivoyage.py (shown with defaults) -----
# URL, local path or s3://...; default = the latest Wikimedia dump
# WIKIVOYAGE_DUMP=
WIKIVOYAGE_FORMAT=jsonl
WIKIVOYAGE_OUTDIR=pages
# Output bucket (bucket or s3://bucket/prefix); unset = write to WIKIVOYAGE_OUTDIR locally
# WIKIVOYAGE_S3_BUCKET=
# 0 = unlimited
WIKIVOYAGE_LIMIT=200
# comma list or * for every article type
WIKIVOYAGE_PAGE_TYPES=city

# ----- Image pipeline: python -m image_embedding (optional, shown with defaults) -----
# ZILLIZ_URI / ZILLIZ_TOKEN above are shared.
ZILLIZ_IMAGE_COLLECTION=wikivoyage_images
# Local dir or s3://bucket/prefix
IMAGES_WORKDIR=images_work
# Dump date YYYYMMDD (or pass --dump-date); "latest" is not accepted
IMAGES_DUMP_DATE=
# e.g. IMAGES_DUMP_DATE=20261101
# Sent on every Wikimedia request; include a contact URL or e-mail
# WIKIVOYAGE_USER_AGENT=wikivoyage-rag/1.0 (https://github.com/<you>/wikivoyage)
IMAGES_MAX_PER_PAGE=50
IMAGES_PAGE_TYPES=*
IMAGES_THUMB_WIDTH=768
IMAGES_ALLOWED_MIME=image/jpeg,image/png,image/webp,image/svg+xml
IMAGES_API_CONCURRENCY=2
IMAGES_DOWNLOAD_CONCURRENCY=3
IMAGES_DOWNLOAD_RPS=4
IMAGES_MIN_SIDE=100
IMAGES_MAX_SIDE=8192
IMAGES_PAD_ASPECT=2.0
IMAGES_FLUSH_EVERY=1000
IMAGES_FETCH_MAX_ATTEMPTS=3
IMAGES_ZILLIZ_BATCH_SIZE=100
SIGLIP_MODEL_ID=google/siglip2-so400m-patch16-384
# Pin a commit hash in production for reproducibility (default: resolve main)
SIGLIP_REVISION=
# auto | cuda | mps | cpu ; dtype auto = bf16 on cuda, fp16 on mps, fp32 on cpu
SIGLIP_DEVICE=auto
SIGLIP_DTYPE=auto
SIGLIP_BATCH_SIZE=32
# keep images/raw and images/processed after embedding (default false = delete them)
IMAGES_KEEP_FILES=false
# Text-search prompt template, e.g. "This is a photo of {}."
SIGLIP_TEXT_TEMPLATE={}

# --- Article DB (python -m article_db): Qwen3 chunks + SigLIP2 images → StructArray collection ---
ZILLIZ_ARTICLE_COLLECTION=wikivoyage_articles
ARTICLES_WORKDIR=articles_work
# embed_chunks.py output (local dir or s3://...); pages default to <chunks>/pages_cache
ARTICLES_CHUNKS_SOURCE=chunks_embedded
ARTICLES_PAGES_SOURCE=
ARTICLES_MAX_CHUNKS=512
ARTICLES_MAX_IMAGES=64
# Zilliz rejects rows above 2 MiB; images, then trailing chunks, are dropped above this
ARTICLES_MAX_ROW_BYTES=1900000
ARTICLES_BATCH_SIZE=50
ARTICLES_MAX_BATCH_BYTES=8388608

# --- Search CLI / retrieval API (article_db.search, article_db.api) ---
# mps / cuda / cpu / auto (Qwen3 query encoder; SigLIP2 uses SIGLIP_DEVICE)
QWEN_DEVICE=auto
ARTICLES_RRF_K=60
ARTICLES_W_TEXT=1.0
ARTICLES_W_IMAGE=0.5
# Origins allowed to call the API from a browser
RETRIEVAL_CORS_ORIGINS=http://localhost:3000

# --- Web app (webapp/): where the retrieval API runs ---
RETRIEVAL_URL=http://127.0.0.1:8001
# EC2 deploy (infra/ec2): optional HTTP basic auth in front of the site (both empty = off)
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=

# --- Databricks (optional backend: databricks/*.py) ---
# DATABRICKS_HOST=xxxx.cloud.databricks.com
# DATABRICKS_TOKEN=
DATABRICKS_VS_ENDPOINT=wikivoyage-ai-search-endpoint
DATABRICKS_VS_INDEX=workspace.default.wikivoyage_page_index_ai_search
DATABRICKS_EMBEDDING_ENDPOINT=databricks-qwen3-embedding-0-6b

# --- Legacy (legacy/: BGE-M3 -> wikivoyage_pages, not maintained) ---
# ZILLIZ_COLLECTION=wikivoyage_pages
# BGE_M3_DEVICE=cpu
# BGE_M3_USE_FP16=0
