# Image pipeline fetch-side stages on AWS Batch (Fargate): dump, extract, commons, fetch, upsert.
# Build context is the repo root (it needs wikivoyage_stream/ and embedding/):
#   docker build -f Dockerfile.images -t wikivoyage-images .
# The embed stage needs torch + a GPU and is not run from this image.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY image_embedding/requirements.txt /app/image_embedding/requirements.txt
RUN pip install --upgrade pip setuptools wheel \
    && PIP_DEFAULT_TIMEOUT=100 \
       pip install --no-cache-dir --retries 5 --timeout 100 \
       -r /app/image_embedding/requirements.txt

COPY wikivoyage_stream /app/wikivoyage_stream
COPY embedding/__init__.py embedding/upserter.py /app/embedding/
COPY get_wikivoyage.py /app/get_wikivoyage.py
COPY image_embedding /app/image_embedding

RUN useradd --create-home --home-dir /home/appuser appuser \
    && chown -R appuser:appuser /app
USER appuser

ENTRYPOINT ["python", "-m", "image_embedding"]
CMD ["--help"]
